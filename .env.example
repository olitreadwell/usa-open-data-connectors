# Optional API keys. Every adapter works keyless; keys unlock more.
# Copy this file to .env and fill in your own keys. Never commit real keys.
SENTRY_DSN=

# CORS for the read-only /api endpoints. Empty means allow any origin.
# Set a single origin to restrict browser access, e.g. https://app.example.com
CORS_ORIGIN=

# Rate limiting for /api routes: per-IP, in-memory fixed window.
# Defaults: 60 requests per minute. Multi-instance deploys should limit at a proxy.
RATE_LIMIT_MAX=
RATE_LIMIT_WINDOW_MS=
