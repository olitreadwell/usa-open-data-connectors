{
  "name": "usa-open-data-connectors",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@10.9.9",
  "engines": {
    "node": ">=22.17.1"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "npm run build -w @open-data-connectors/usa-sources && npm run build -w @open-data-connectors/connectors-cli",
    "start": "next start",
    "setup": "node scripts/setup.mjs",
    "lint": "npm run lint --workspaces --if-present",
    "format": "npm run format --workspaces --if-present",
    "format:check": "npm run format:check --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:watch": "vitest",
    "test:coverage": "npm run test:coverage --workspaces --if-present",
    "test:e2e": "playwright test",
    "test:a11y": "playwright test a11y",
    "perf": "pnpm dlx @lhci/cli@latest autorun",
    "smoke": "bash scripts/smoke.sh",
    "check:links": "node scripts/check-internal-links.mjs",
    "check:external-links": "node scripts/check-external-links.mjs",
    "audit": "npm audit",
    "test:setup": "node --test scripts/setup.test.mjs",
    "check": "npm run format:check && npm run build && npm run lint && npm run type-check && npm run test:coverage",
    "type-check": "npm run type-check --workspaces --if-present",
    "test:smoke": "npm run test:smoke --workspaces --if-present",
    "dev:api": "npm run dev -w @open-data-connectors/connectors-api",
    "start:api": "npm run start -w @open-data-connectors/connectors-api"
  },
  "devDependencies": {
    "prettier": "3.9.9",
    "@vitest/coverage-v8": "3.2.7"
  },
  "dependencies": {},
  "description": "USA open data connectors: TypeScript adapters, HTTP API, and CLI for US public data"
}
