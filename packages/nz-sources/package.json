{
  "name": "@nzlab/nz-sources",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepublishOnly": "npm run build",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.{ts,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,json}\"",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest --watch",
    "clean": "rm -rf dist tsconfig.tsbuildinfo tsconfig.build.tsbuildinfo coverage",
    "clean:all": "rm -rf dist tsconfig.tsbuildinfo tsconfig.build.tsbuildinfo coverage node_modules",
    "test:smoke": "RUN_SMOKE=1 vitest run src/smoke.test.ts"
  },
  "devDependencies": {
    "@nzlab/config-eslint": "*",
    "@nzlab/config-typescript": "*",
    "@types/node": "22.20.1",
    "eslint": "9.39.5",
    "typescript": "6.0.3",
    "vitest": "3.2.7"
  },
  "dependencies": {
    "fast-xml-parser": "5.11.1",
    "zod": "3.25.76"
  },
  "publishConfig": {
    "access": "public"
  }
}
