    "publicationStage": "published",
    "queryString": "SELECT\n  `casenumber`,\n  `createddate`,\n  `systemmodstamp`,\n  `action_taken__c`,\n  `department_name__c`,\n  `type`,\n  `status`,\n  `origin`,\n  `created_by_user_organization`,\n  `reported_anonymously__c`,\n  `assigned_to__c`,\n  `service_date__c`,\n  `closeddate`,\n  `date_service_was_rendered`,\n  `reason_code__c`,\n  `resolution_code__c`,\n  `locator_gis_returned_address`,\n  `locator_sr_house_number_`,\n  `locator_direction_suffix`,\n  `locator_sr_street_name__c`,\n  `locator_service_request_suffix`,\n  `zipcode__c`,\n  `geolocation__latitude__s`,\n  `geolocation__longitude__s`,\n  `location`,\n  `locator_sr_tb_map_grid_page`,\n  `locator_sr_tb_column__c`,\n  `locator_sr_tb_row__c`,\n  `locator_sr_area_planning`,\n  `locator_council_district`,\n  `locator_sr_council_district`,\n  `locator_sr_neigborhood_council`,\n  `locator_sr_neigborhood_council_1`,\n  `locator_sr_community_police`\nWHERE\n  `createddate`\n    BETWEEN \"2026-01-01T00:00:00\" :: floating_timestamp\n    AND \"2026-12-31T23:59:59\" :: floating_timestamp\n  AND caseless_one_of(\n    `type`,\n    \"Accessible Bus Stop Issues\",\n    \"Animal Complaint/Violation\",\n    \"Animal Confined\",\n    \"Animal Loose\",\n    \"Barricade Removal\",\n    \"Bees or Beehive\",\n    \"Bicycle Facilities Issues\",\n    \"Bus Pad/Landing\",\n    \"Bus Stop Furniture\",\n    \"Bus Stop Parking Sign & Markings\",\n    \"Curb Issues\",\n    \"Dead Animal Removal\",\n    \"Dockless Mobility Enforcement\",\n    \"Feedback\",\n    \"Flooding\",\n    \"General Street Inspection\",\n    \"Graffiti Removal\",\n    \"Guard/Warning Rail Maintenance\",\n    \"Homeless Encampment\",\n    \"Illegal Activities (Non-Emergency)\",\n    \"Illegal Auto Repair or Construction, and Leaf Blower Violations\",\n    \"Illegal Discharge of Water\",\n    \"Illegal Dumping Food Waste\",\n    \"Illegal Dumping Item Pickup\",\n    \"Illegal Sign Removal, News Rack Issues\",\n    \"Information-Only\",\n    \"Item Pickups\",\n    \"LADOT Council & Interagency Support\",\n    \"Land/Mud Slide\",\n    \"Landscape Maintenance\",\n    \"Median Island Maintenance\",\n    \"Nuisance Barking Dogs\",\n    \"Obstructions\",\n    \"Other\",\n    \"Park Amenity and Facilities Repair\",\n    \"Park Cleanliness, Trash and Ground Maintenance\",\n    \"Parking Issues\",\n    \"Parking Meter Maintenance\",\n    \"Private Property Violation\",\n    \"Program Research\",\n    \"Public Right-of-Way Cleanup\",\n    \"Public Street Receptacles\",\n    \"Report a Sidewalk Problem\",\n    \"Report Water Wasting\",\n    \"Searchlight & Generator Permits\",\n    \"Service Not Complete\",\n    \"Sewer or Sidewalk Rebates\",\n    \"Sidewalk Repair Access Request Program\",\n    \"Streetlight ADA Repair Services\",\n    \"Streetlight Non-Repair Services\",\n    \"Streetlight Repair Services\",\n    \"Street Pavement Issues\",\n    \"Street Sweeping\",\n    \"Street Tree Inspection\",\n    \"Street Tree Violations\",\n    \"Taxi Complaints\",\n    \"Traffic Safety\",\n    \"Traffic Signal Issues\",\n    \"Traffic Sign Issues\",\n    \"Tree Emergency\",\n    \"Tree Obstruction\",\n    \"Trees or Pests in the Park\",\n    \"Watershed Protection Division (WPD) Enforcement\"\n  )",
