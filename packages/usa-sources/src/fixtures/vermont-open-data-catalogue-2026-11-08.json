  {
    "id": "nf9b-kwcd",
    "name": "FY2025 Vermont Grants Issued",
    "assetType": "filter",
    "averageRating": 0,
    "category": "Finance",
    "createdAt": 1769694852,
    "description": "Beginning January 31, 2010, pursuant to 32 V.S.A. § 314, the Department of Finance and Management is required to issue an annual report of all grants awarded. In 2012, the Department began a pilot program to include non-federal grants in its database; this effort continues today, and those grants are included in the dataset.\n\nAwards included in this dataset reflect grants authorized by a State of Vermont department to a grantee during the applicable report year. Funds may or may not have been expended or received by the grantee during that year. For multi-year grants, the full award amount is reported only in the year the grant was initially issued and is not reported in subsequent years. Any subsequent amendments to a grant are not reflected in this report.",
    "diciBackend": false,
    "displayType": "table",
    "downloadCount": 51,
    "hideFromCatalog": false,
    "hideFromDataJson": false,
    "locked": false,
    "modifyingViewUid": "xifk-zskz",
    "newBackend": true,
    "numberOfComments": 0,
    "oid": 41898764,
    "provenance": "official",
    "publicationAppendEnabled": false,
    "publicationDate": 1769695057,
    "publicationGroup": 14761071,
    "publicationStage": "published",
    "queryString": "SELECT\n  `granting_department`,\n  `grant_number`,\n  `grant_description`,\n  `funding_source`,\n  `cfda`,\n  `start_date`,\n  `end_date`,\n  `fiscal_year_issued`,\n  `award_amount`,\n  `grantee_name`,\n  `address_line_1`,\n  `address_line_2`,\n  `city`,\n  `st`,\n  `zip`\nWHERE caseless_one_of(`fiscal_year_issued`, \"2025\")",
